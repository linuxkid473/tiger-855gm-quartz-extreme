#!/bin/sh
# gfx-mode MODE   (needs sudo + reboot)
#   stable/vsync -> p54t (p54 with a 100x longer GPU wait timeout; the stable setup)   fast -> p56f (experimental: froze with hardware-GL VLC)   status
#   or any staged variant name: p51 p53 p54 p55 p55f p56 p56f  (/Library/AppleIntel830.<name>)
K=/System/Library/Extensions/AppleIntel830.kext/Contents/MacOS/AppleIntel830
case "$1" in
  vsync|stable) SRC=/Library/AppleIntel830.p54t;;
  fast)  SRC=/Library/AppleIntel830.p56f;;
  p*)    SRC=/Library/AppleIntel830.$1;;
  *) echo "current: `md5 -q $K 2>/dev/null || md5 $K`"; for v in p51 p53 p54 p54t p55 p55f p56 p56f; do [ -f /Library/AppleIntel830.$v ] && echo "$v `md5 -q /Library/AppleIntel830.$v 2>/dev/null`"; done; exit 0;;
esac
[ -f "$SRC" ] || { echo "no such variant: $SRC"; exit 1; }
[ "`id -u`" = 0 ] || { echo "run with sudo"; exit 1; }
cp $SRC $K && chown root:wheel $K && chmod 755 $K && touch /System/Library/Extensions && kextcache -l -m /System/Library/Extensions.mkext /System/Library/Extensions >/dev/null 2>&1
echo "installed $1 (`md5 -q $K 2>/dev/null`); reboot to apply"
