#!/bin/sh
# Start VLC on the HARDWARE 855GM OpenGL renderer (hardware YCbCr video). EXPERIMENTAL: can lock the GPU up (docs/16, docs/17).
# VLC is started through LaunchServices (`open -a VLC`) so it is a normal app (Dock icon, menu bar, Cmd-Q); the installed VLC wrapper
# (tools/system/app-wrapper-vlc) sees the request file and uses the hardware stack for that launch.  If VLC is already running the
# files are just handed to that instance (quit it first to get a hardware launch).
touch /tmp/.vlc-hw-request
exec open -a VLC "$@"
