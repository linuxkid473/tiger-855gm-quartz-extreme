#!/bin/sh
# Launch VLC on the hardware 855GM OpenGL renderer (hardware YCbCr video).
# HOME is deliberately absent: the GL driver treats HOME as "software renderer for normal apps".
exec env -i PATH=/usr/bin:/bin:/usr/sbin \
  DYLD_FRAMEWORK_PATH=/Library/OGL1041 \
  DYLD_LIBRARY_PATH=/Library/OGL1041/OpenGL.framework/Versions/A/Libraries \
  /Applications/VLC.app/Contents/MacOS/VLC --no-plugins-cache "$@"
